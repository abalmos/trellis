{
  "apis": [
    {
      "format": "trellis.api.v1",
      "id": "consumer@v1",
      "version": "1.0.0",
      "displayName": "Consumer API",
      "description": "Exercises every selectable API surface.",
      "schemas": {
        "Any": true,
        "Event": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string" } }
        }
      },
      "rpc": {
        "Consumer.Get": {
          "version": "v1",
          "input": { "schema": "Any" },
          "output": { "schema": "Any" }
        }
      },
      "operations": {
        "Consumer.Run": {
          "version": "v1",
          "input": { "schema": "Any" },
          "cancel": true,
          "signals": { "approve": { "input": { "schema": "Any" } } }
        },
        "Consumer.Simple": {
          "version": "v1",
          "input": { "schema": "Any" }
        }
      },
      "events": {
        "Consumer.Changed": {
          "version": "v1",
          "event": { "schema": "Event" },
          "params": ["/id"]
        }
      },
      "feeds": {
        "Consumer.Watch": {
          "version": "v1",
          "input": { "schema": "Any" },
          "event": { "schema": "Any" }
        }
      },
      "state": {
        "Consumer.Settings": {
          "kind": "value",
          "schema": { "schema": "Any" }
        }
      },
      "capabilities": {
        "everything": {
          "allows": [
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "rpc",
                "name": "Consumer.Get"
              },
              "action": "call"
            },
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "operation",
                "name": "Consumer.Run"
              },
              "action": "invoke"
            },
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "operation",
                "name": "Consumer.Run"
              },
              "action": "observe"
            },
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "operation",
                "name": "Consumer.Run"
              },
              "action": "cancel"
            },
            {
              "target": {
                "kind": "operationSignal",
                "api": "consumer@v1",
                "operation": "Consumer.Run",
                "signal": "approve"
              },
              "action": "control"
            },
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "event",
                "name": "Consumer.Changed"
              },
              "action": "publish"
            },
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "event",
                "name": "Consumer.Changed"
              },
              "action": "subscribe"
            },
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "feed",
                "name": "Consumer.Watch"
              },
              "action": "subscribe"
            },
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "state",
                "name": "Consumer.Settings"
              },
              "action": "read"
            },
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "state",
                "name": "Consumer.Settings"
              },
              "action": "write"
            }
          ]
        },
        "partial": {
          "allows": [
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "rpc",
                "name": "Consumer.Get"
              },
              "action": "call"
            },
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "operation",
                "name": "Consumer.Simple"
              },
              "action": "invoke"
            }
          ]
        },
        "rpcOnly": {
          "allows": [
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "rpc",
                "name": "Consumer.Get"
              },
              "action": "call"
            }
          ]
        },
        "𐀀": {
          "allows": [
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "rpc",
                "name": "Consumer.Get"
              },
              "action": "call"
            }
          ]
        },
        "": {
          "allows": [
            {
              "target": {
                "kind": "apiSurface",
                "api": "consumer@v1",
                "surface": "rpc",
                "name": "Consumer.Get"
              },
              "action": "call"
            }
          ]
        }
      },
      "consent": {
        "everything": {
          "title": "Use consumer API",
          "description": "Use every selected surface.",
          "consequence": "The participant can use every selected surface."
        },
        "rpcOnly": {
          "title": "Read consumer records",
          "description": "Read records through the consumer API.",
          "consequence": "The participant can read consumer records."
        }
      }
