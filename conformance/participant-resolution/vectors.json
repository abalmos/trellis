          }
        }
      },
      "operations": {
        "Provider.Import": {
          "version": "v1",
          "input": { "schema": "Input" },
          "transfer": { "direction": "send" },
          "signals": { "confirm": { "input": { "schema": "Input" } } }
        },
        "Provider.Simple": {
          "version": "v1",
          "input": { "schema": "Input" }
        }
      }
    },
