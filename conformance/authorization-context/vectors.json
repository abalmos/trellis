  "cases": [
    {
      "name": "valid-chain",
      "operation": "verifyContext",
      "expected": {
        "valid": true,
        "output": {
          "issuerKeyId": "ajgD1fBZkCocba-8m6RykhL3yqwIY0zDrnaydSnwOCc",
          "issuerManifestGeneration": 7,
          "contextDigest": "QBG0Utl1erhLs1aYVhNpyoe0JGLTfBbrRiwO_ImK00w"
        }
      }
    },
    {
      "name": "bad-manifest-root-signature",
      "operation": "verifyManifest",
      "mutations": [
        {
          "target": "manifest",
          "op": "replace",
          "path": "/signature",
          "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        }
      ],
      "expected": {
        "valid": false,
        "code": "InvalidSignature",
        "path": "/signature"
      }
    },
    {
      "name": "manifest-key-id-public-key-mismatch",
      "operation": "verifyManifest",
      "mutations": [
        {
          "target": "manifest",
          "op": "replace",
          "path": "/issuers/0/keyId",
          "value": "NHUPmL1Z_PyUbaRaqr6TO-FUpLUJThxKv0KGZQXzyX4"
        }
      ],
      "expected": {
        "valid": false,
        "code": "InvalidKeyId",
        "path": "/issuers/0/keyId"
      }
    },
    {
      "name": "manifest-rollback",
      "operation": "verifyManifest",
      "inputs": { "policy": { "minimumManifestGeneration": 8 } },
      "expected": {
        "valid": false,
        "code": "ManifestRollback",
        "path": "/generation"
      }
    },
    {
      "name": "context-generation-mismatch",
      "operation": "verifyContext",
      "mutations": [
        {
          "target": "context",
          "op": "replace",
          "path": "/issuerManifestGeneration",
          "value": 8
        }
      ],
      "resign": ["context"],
      "expected": {
        "valid": false,
        "code": "ManifestGenerationMismatch",
        "path": "/issuerManifestGeneration"
      }
    },
    {
      "name": "issuer-absent",
      "operation": "verifyContext",
      "mutations": [
        { "target": "manifest", "op": "remove", "path": "/issuers/0" }
      ],
      "resign": ["manifest"],
      "expected": {
        "valid": false,
        "code": "IssuerNotListed",
        "path": "/issuerKeyId"
      }
    },
    {
      "name": "issuer-signature-invalid",
      "operation": "verifyContext",
      "mutations": [
        {
          "target": "context",
          "op": "replace",
          "path": "/signature",
          "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        }
      ],
      "expected": {
        "valid": false,
        "code": "InvalidSignature",
        "path": "/signature"
      }
    },
    {
      "name": "context-outlives-manifest",
      "operation": "verifyContext",
      "mutations": [
        {
          "target": "context",
          "op": "replace",
          "path": "/expiresAt",
          "value": 1600
        }
      ],
      "resign": ["context"],
      "expected": {
        "valid": false,
        "code": "ContextOutlivesManifest",
        "path": "/expiresAt"
      }
    },
    {
      "name": "permission-limit",
      "operation": "verifyContext",
      "mutations": [
        {
          "target": "context",
          "op": "add",
          "path": "/grantSet/permissions/-",
          "value": {
            "action": "call",
            "target": {
              "api": "documents@v1",
              "kind": "apiSurface",
              "name": "Documents.List",
              "surface": "rpc"
            }
          }
        }
      ],
      "resign": ["context"],
      "inputs": { "policy": { "maximumPermissions": 1 } },
      "expected": {
        "valid": false,
        "code": "InvalidFormat",
        "path": "/grantSet/permissions"
      }
    },
    {
      "name": "capability-limit",
      "operation": "verifyContext",
      "mutations": [
        {
          "target": "context",
          "op": "add",
          "path": "/capabilities/-",
          "value": "platform.write"
        }
      ],
      "resign": ["context"],
      "inputs": { "policy": { "maximumCapabilities": 1 } },
      "expected": {
        "valid": false,
        "code": "InvalidFormat",
        "path": "/capabilities"
      }
    },
    {
      "name": "current-request-proof-valid",
      "operation": "verifyRequest",
      "inputs": {
        "request": {
          "subject": "rpc.v1.Documents.Get",
          "reply": "_INBOX.test.reply",
          "payload": "{\"id\":\"doc-1\"}",
          "iat": 1100,
          "requestId": "req_test"
        }
      },
      "expected": { "valid": true }
    },
    {
      "name": "current-request-proof-invalid",
      "operation": "verifyRequest",
      "inputs": {
        "request": {
          "subject": "rpc.v1.Documents.Get",
          "reply": "_INBOX.test.reply",
          "payload": "changed",
          "iat": 1100,
          "requestId": "req_test"
        }
      },
      "expected": {
        "valid": false,
        "code": "InvalidRequestProof",
        "path": "/proof"
      }
    },
    {
      "name": "event-proof-valid",
      "operation": "verifyEvent",
      "inputs": { "policy": { "nowUnixSeconds": 1400 } },
      "expected": { "valid": true }
    },
    {
      "name": "event-proof-invalid",
      "operation": "verifyEvent",
      "mutations": [
        {
          "target": "event",
          "op": "replace",
          "path": "/eventId",
          "value": "evt_changed"
        }
      ],
      "expected": {
        "valid": false,
        "code": "InvalidEventProof",
        "path": "/proof"
      }
    },
    {
      "name": "historical-exact-generation",
      "operation": "verifyEvent",
      "inputs": { "policy": { "nowUnixSeconds": 1400 }, "historical": true },
      "expected": { "valid": true, "output": { "issuerManifestGeneration": 7 } }
    },
    {
      "name": "current-floor-rejection",
      "operation": "verifyContext",
      "inputs": { "policy": { "minimumManifestGeneration": 8 } },
      "expected": {
        "valid": false,
        "code": "ManifestRollback",
        "path": "/generation"
      }
    }
  ]
}
