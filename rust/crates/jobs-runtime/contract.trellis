    rootJobId?: string;
  }
  model JoblogsItem {
    level: "info" | "warn" | "error";
    message: string;
    timestamp: string(format="date-time");
  }
  model Jobprogress {
    current?: uint;
    message?: string;
    step?: string;
    total?: uint;
  }
  model JobqueuePolicy {
    existingJobId?: string(min_length=1);
    outcome: string(min_length=1);
    reason?: string(min_length=1);
    replacedJobId?: string(min_length=1);
  }
  model Jobtrigger {
    id?: string;
    kind: "schedule" | "operation" | "rpc" | "event" | "manualReplay" | "serviceCode" | "parentJob";
    operationId?: string;
    parentJobId?: string;
    requestId?: string;
    subject?: string;
    traceId?: string;
  }
  model JobwaitingOnItem {
    id: string(min_length=1);
    label?: string(min_length=1);
    startedAt: string(format="date-time");
    target: JobwaitingOnItemtarget;
  }
  model JobErrorDetailcausesItem {
  }
  model JobErrorDetailworker {
    instanceId?: string;
    runtime?: string;
    service?: string;
    version?: string;
  }
  model JobTimelineEventerrorDetail {
    causes?: list<JobTimelineEventerrorDetailcausesItem>;
