    traceparent: string(pattern="^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$");
    tracestate?: string(min_length=1);
  }
  model JoberrorDetail {
    causes?: list<JoberrorDetailcausesItem>;
    fingerprint: string(min_length=1);
    firstSeen?: string(format="date-time");
