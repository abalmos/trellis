    result?: json;
    service: string(min_length=1);
    startedAt?: string(format="date-time");
    state: "pending" | "active" | "retry" | "completed" | "failed" | "cancelled" | "skipped" | "stale" | "expired" | "dead" | "dismissed";
    tries: uint;
    trigger?: JobsCancelResponsejobtrigger;
    type: string(min_length=1);
    updatedAt: string(format="date-time");
    waitingOn?: list<JobsCancelResponsejobwaitingOnItem>;
  }
