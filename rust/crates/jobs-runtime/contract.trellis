api "trellis.jobs@v1" {
  version "1.0.0";
  display_name "Trellis Jobs";
  description "Trellis-managed background job administration API.";
  model Empty {
  }
  model Job {
    completedAt?: string(format="date-time");
    concurrency?: Jobconcurrency;
    context: Jobcontext;
    createdAt: string(format="date-time");
    deadline?: string(format="date-time");
    errorDetail?: JoberrorDetail;
    id: string(min_length=1);
    lastError?: string;
    lineage?: Joblineage;
    logs?: list<JoblogsItem>;
    maxTries: int(minimum=1);
    payload: json;
    progress?: Jobprogress;
    queuePolicy?: JobqueuePolicy;
    result?: json;
    service: string(min_length=1);
    startedAt?: string(format="date-time");
    state: "pending" | "active" | "retry" | "completed" | "failed" | "cancelled" | "skipped" | "stale" | "expired" | "dead" | "dismissed";
    tries: uint;
    trigger?: Jobtrigger;
    type: string(min_length=1);
    updatedAt: string(format="date-time");
    waitingOn?: list<JobwaitingOnItem>;
  }
  model JobConcurrencyMetadata {
    heartbeatAt?: string(format="date-time");
    key: string(min_length=1);
    keyHash: string(min_length=1);
    leaseExpiresAt?: string(format="date-time");
    staleTakeoverCount?: uint;
  }
  model JobContext {
    requestId: string(min_length=1);
    traceId: string(pattern="^[0-9a-f]{32}$");
    traceparent: string(pattern="^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$");
    tracestate?: string(min_length=1);
  }
  model JobErrorDetail {
    causes?: list<JobErrorDetailcausesItem>;
    fingerprint: string(min_length=1);
    firstSeen?: string(format="date-time");
    message: string;
    occurrenceCount?: uint;
    stack?: string;
    type?: string;
    worker?: JobErrorDetailworker;
  }
  model JobLineage {
    operationId?: string;
    parentJobId?: string;
    relatedKeys?: list<string>;
    rootJobId?: string;
  }
  model JobLogEntry {
    level: "info" | "warn" | "error";
    message: string;
    timestamp: string(format="date-time");
  }
  model JobProgress {
    current?: uint;
    message?: string;
    step?: string;
    total?: uint;
  }
  model JobQueuePolicyMetadata {
    existingJobId?: string(min_length=1);
    outcome: string(min_length=1);
    reason?: string(min_length=1);
    replacedJobId?: string(min_length=1);
  }
  type JobState = "pending" | "active" | "retry" | "completed" | "failed" | "cancelled" | "skipped" | "stale" | "expired" | "dead" | "dismissed";
  model JobTimelineEvent {
    error?: string;
    errorDetail?: JobTimelineEventerrorDetail;
    logs?: list<JobTimelineEventlogsItem>;
    message?: string;
    previousState?: "pending" | "active" | "retry" | "completed" | "failed" | "cancelled" | "skipped" | "stale" | "expired" | "dead" | "dismissed";
    progress?: JobTimelineEventprogress;
    projected?: bool;
    rawEvent?: json;
    reason?: string;
    sequence: uint;
    state: "pending" | "active" | "retry" | "completed" | "failed" | "cancelled" | "skipped" | "stale" | "expired" | "dead" | "dismissed";
    timestamp: string(format="date-time");
    tries?: uint;
    type: string(min_length=1);
    waitEdge?: JobTimelineEventwaitEdge;
    workerInstanceId?: string;
  }
  model JobTrigger {
    id?: string;
    kind: "schedule" | "operation" | "rpc" | "event" | "manualReplay" | "serviceCode" | "parentJob";
    operationId?: string;
    parentJobId?: string;
    requestId?: string;
    subject?: string;
    traceId?: string;
  }
  model JobWaitEdge {
    id: string(min_length=1);
    label?: string(min_length=1);
    startedAt: string(format="date-time");
    target: JobWaitEdgetarget;
  }
  model JobWaitTarget {
    id?: string(min_length=1);
    key?: string(min_length=1);
    kind: "job" | "operation" | "external";
    label?: string(min_length=1);
    operation?: string(min_length=1);
    operationId?: string(min_length=1);
    service?: string(min_length=1);
    system?: string(min_length=1);
    type?: string(min_length=1);
  }
  model JobsCancelRequest {
    id: string(min_length=1);
    reason?: string(min_length=1);
  }
  model JobsCancelResponse {
    job: JobsCancelResponsejob;
  }
  model JobsDismissDLQRequest {
    id: string(min_length=1);
    reason?: string(min_length=1);
  }
  model JobsDismissDLQResponse {
    job: JobsDismissDLQResponsejob;
  }
  model JobsGetKeyRequest {
    key: string(min_length=1);
    service: string(min_length=1);
    type: string(min_length=1);
  }
  model JobsGetKeyResponse {
    active: list<JobsGetKeyResponseactiveItem>;
    key: string(min_length=1);
    keyHash: string(min_length=1);
    latestPolicyReason?: string(min_length=1);
    queued: list<JobsGetKeyResponsequeuedItem>;
    queuedDepth: uint;
    service: string(min_length=1);
    staleTakeoverCount: uint;
    type: string(min_length=1);
  }
  model JobsInspectRequest {
    id: string(min_length=1);
  }
  model JobsInspectResponse {
    attempts: list<JobsInspectResponseattemptsItem>;
    errors: list<JobsInspectResponseerrorsItem>;
    job: JobsInspectResponsejob;
    lineage?: JobsInspectResponselineage;
    related: list<JobsInspectResponserelatedItem>;
    timeline: list<JobsInspectResponsetimelineItem>;
    trigger?: JobsInspectResponsetrigger;
  }
  model JobsListDLQRequest {
    limit: int(minimum=1);
    offset?: uint;
    service?: string(min_length=1);
    since?: string(format="date-time");
    type?: string(min_length=1);
  }
  model JobsListDLQResponse {
    count: uint;
    entries: list<JobsListDLQResponseentriesItem>;
    limit: int(minimum=1);
    nextOffset?: uint;
    offset: uint;
  }
  model JobsListServicesRequest {
    limit: int(minimum=1);
    offset?: uint;
  }
  model JobsListServicesResponse {
    count: uint;
    entries: list<JobsListServicesResponseentriesItem>;
    limit: int(minimum=1);
    nextOffset?: uint;
    offset: uint;
  }
  model JobsMetricsBucket {
    end: string(format="date-time");
    groups: list<JobsMetricsBucketgroupsItem>;
    start: string(format="date-time");
  }
  model JobsMetricsBucketGroup {
    cancelled: uint;
    completed: uint;
    dead: uint;
    dismissed: uint;
    failed: uint;
    key: string;
    label: string;
    queueWait: JobsMetricsBucketGroupqueueWait;
    retried: uint;
    runtime: JobsMetricsBucketGroupruntime;
    started: uint;
    submitted: uint;
  }
  model JobsMetricsLatency {
    count: uint;
    maxMs?: uint;
    p50Ms?: uint;
    p95Ms?: uint;
  }
  model JobsMetricsRequest {
    groupBy: "type" | "service" | "queueKey" | "state" | "trigger";
    queueKey?: string;
    service?: string(min_length=1);
    state?: list<"pending" | "active" | "retry" | "completed" | "failed" | "cancelled" | "skipped" | "stale" | "expired" | "dead" | "dismissed">;
    step: "1m" | "5m" | "15m" | "1h" | "6h" | "1d";
    trigger?: string;
    type?: string(min_length=1);
    window: "15m" | "1h" | "6h" | "24h" | "7d";
  }
  model JobsMetricsResponse {
    buckets: list<JobsMetricsResponsebucketsItem>;
    generatedAt: string(format="date-time");
    groupBy: string;
    step: string;
    summary: list<JobsMetricsResponsesummaryItem>;
    window: string;
  }
  model JobsMetricsSummaryGroup {
    byState: map<uint>;
    dead?: uint;
    failed?: uint;
    failureRate?: number(minimum=0);
    key: string;
    label: string;
    latestUpdatedAt?: string(format="date-time");
    oldestCreatedAt?: string(format="date-time");
    queueWait: JobsMetricsSummaryGroupqueueWait;
    queued?: uint;
    running?: uint;
    runtime: JobsMetricsSummaryGroupruntime;
    slow?: uint;
    total: uint;
  }
  model JobsQueryRequest {
    groupBy?: "service" | "type" | "state" | "queueKey" | "trigger" | "runtimeBand";
    limit: int(minimum=1);
    offset?: uint;
    queueKey?: string;
    runtimeBand?: "queued" | "running" | "slow" | "terminal";
    search?: string;
    service?: string(min_length=1);
    sort?: JobsQueryRequestsort;
    state?: list<"pending" | "active" | "retry" | "completed" | "failed" | "cancelled" | "skipped" | "stale" | "expired" | "dead" | "dismissed">;
    trigger?: string;
    type?: string(min_length=1);
    window?: "1h" | "24h" | "7d";
  }
  model JobsQueryResponse {
    count: uint;
    entries: list<JobsQueryResponseentriesItem>;
    groups: list<JobsQueryResponsegroupsItem>;
    limit: int(minimum=1);
    nextOffset?: uint;
    offset: uint;
    stats: JobsQueryResponsestats;
  }
  model JobsReplayDLQRequest {
    id: string(min_length=1);
    reason?: string(min_length=1);
  }
  model JobsReplayDLQResponse {
    job: JobsReplayDLQResponsejob;
  }
  model JobsRetryRequest {
    id: string(min_length=1);
    reason?: string(min_length=1);
  }
  model JobsRetryResponse {
    job: JobsRetryResponsejob;
  }
  type JobsWatchFrame = JobsWatchFrameValue1 | JobsWatchFrameValue2 | JobsWatchFrameValue3 | JobsWatchFrameValue4;
  model JobsWatchRequest {
    includeInitial?: bool;
    jobId?: string(min_length=1);
    query?: JobsWatchRequestquery;
  }
  model JobsWorkbenchGroup {
    count: uint;
    depth?: uint;
    failureRate?: number(minimum=0);
    key: string;
    label: string;
    latestUpdatedAt?: string(format="date-time");
    oldestCreatedAt?: string(format="date-time");
    state?: "pending" | "active" | "retry" | "completed" | "failed" | "cancelled" | "skipped" | "stale" | "expired" | "dead" | "dismissed";
  }
  model JobsWorkbenchJobRow {
    completedAt?: string(format="date-time");
    context?: JobsWorkbenchJobRowcontext;
    createdAt: string(format="date-time");
    errorFingerprint?: string;
    id: string(min_length=1);
    lastError?: string;
    lineage?: JobsWorkbenchJobRowlineage;
    maxTries: int(minimum=1);
    progress?: JobsWorkbenchJobRowprogress;
    queueAgeMs?: uint;
    queueKey?: string;
    runtimeBand?: string;
    runtimeMs?: uint;
    service: string(min_length=1);
    startedAt?: string(format="date-time");
    state: "pending" | "active" | "retry" | "completed" | "failed" | "cancelled" | "skipped" | "stale" | "expired" | "dead" | "dismissed";
    tries: uint;
    trigger?: JobsWorkbenchJobRowtrigger;
    type: string(min_length=1);
    updatedAt: string(format="date-time");
    waitingOn?: list<JobsWorkbenchJobRowwaitingOnItem>;
  }
  model JobsWorkbenchStats {
    byState: map<uint>;
    dead?: uint;
    failed?: uint;
    queued?: uint;
    running?: uint;
    slow?: uint;
    total: uint;
  }
  model NotFoundErrorData {
    context?: NotFoundErrorDatacontext;
    id: string(min_length=1);
    jobId?: string(min_length=1);
    message: string;
    resource: string(min_length=1);
    traceId?: string;
    type: "NotFoundError";
  }
  model Jobconcurrency {
    heartbeatAt?: string(format="date-time");
    key: string(min_length=1);
    keyHash: string(min_length=1);
    leaseExpiresAt?: string(format="date-time");
    staleTakeoverCount?: uint;
  }
  model Jobcontext {
