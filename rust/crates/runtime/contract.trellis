    errors [AuthError, UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.auth::users.read"];
    }
  }
  rpc "Auth.Users.Password.Change" {
    version "v1";
    input AuthUsersPasswordChangeRequest;
    output AuthUsersPasswordChangeResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc "Auth.Users.PasswordReset.Create" {
    version "v1";
    input AuthUsersPasswordResetCreateRequest;
    output AuthUsersPasswordResetCreateResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.auth::users.mutate"];
    }
  }
  rpc "Auth.Users.Resolve" {
    version "v1";
    input AuthUsersResolveRequest;
    output AuthUsersResolveResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.auth::users.read"];
    }
  }
  rpc "Auth.Users.Update" {
    version "v1";
    input AuthUsersUpdateRequest;
    output AuthUsersUpdateResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.auth::users.mutate"];
    }
  }
  operation "Auth.DeviceUserAuthorities.Resolve" {
    version "v1";
    input AuthDeviceUserAuthoritiesResolveRequest;
    output AuthDeviceUserAuthoritiesResolveResponse;
    progress AuthDeviceUserAuthoritiesResolveProgress;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  event "Auth.Connections.Closed" {
    version "v1";
    event AuthConnectionsClosedEvent;
    capabilities {
      subscribe ["trellis.auth::events.stream"];
    }
  }
  event "Auth.Connections.Kicked" {
    version "v1";
    event AuthConnectionsKickedEvent;
    capabilities {
      subscribe ["trellis.auth::events.stream"];
    }
  }
  event "Auth.Connections.Opened" {
    version "v1";
    event AuthConnectionsOpenedEvent;
    capabilities {
      subscribe ["trellis.auth::events.stream"];
    }
  }
  event "Auth.DeviceUserAuthorities.Approved" {
    version "v1";
    event AuthDeviceUserAuthoritiesApprovedEvent;
    params ["/deploymentId"];
    capabilities {
      subscribe ["trellis.auth::events.stream"];
    }
  }
  event "Auth.DeviceUserAuthorities.Requested" {
    version "v1";
    event AuthDeviceUserAuthoritiesRequestedEvent;
    params ["/deploymentId"];
    capabilities {
      subscribe ["trellis.auth::events.stream"];
    }
  }
  event "Auth.DeviceUserAuthorities.Resolved" {
    version "v1";
    event AuthDeviceUserAuthoritiesResolvedEvent;
    params ["/deploymentId"];
    capabilities {
      subscribe ["trellis.auth::events.stream"];
    }
  }
  event "Auth.DeviceUserAuthorities.ReviewRequested" {
    version "v1";
    event AuthDeviceUserAuthoritiesReviewRequestedEvent;
    params ["/deploymentId"];
    capabilities {
      subscribe ["trellis.auth::events.stream"];
    }
  }
  event "Auth.Sessions.Revoked" {
    version "v1";
    event AuthSessionsRevokedEvent;
    capabilities {
      subscribe ["trellis.auth::events.stream"];
    }
  }
}

api "trellis.core@v1" {
  version "1.0.0";
  display_name "Trellis Core";
  description "Trellis runtime RPCs available to all connected participants.";
  model TrellisSurfaceStatusRequest {
    action?: "call" | "publish" | "subscribe" | "observe";
    contractId: string(min_length=1);
    kind: "rpc" | "operation" | "event" | "feed";
    surface: string(min_length=1);
  }
  model TrellisSurfaceStatusResponse {
    status: TrellisSurfaceStatusResponsestatus1 | TrellisSurfaceStatusResponsestatus2 | TrellisSurfaceStatusResponsestatus3 | TrellisSurfaceStatusResponsestatus4 | TrellisSurfaceStatusResponsestatus5;
  }
  model TrellisSurfaceStatusResponsestatus1 {
    liveImplementer: bool;
    runtime: "live" | "no_live_implementer" | "disabled";
    state: "available";
  }
  model TrellisSurfaceStatusResponsestatus2 {
    reason: "authority_unavailable";
    state: "unavailable";
  }
  model TrellisSurfaceStatusResponsestatus3 {
    missingCapabilities: list<string>;
    state: "unauthorized";
  }
  model TrellisSurfaceStatusResponsestatus4 {
    contractId: string(min_length=1);
    state: "unknown_contract";
  }
  model TrellisSurfaceStatusResponsestatus5 {
    contractId: string(min_length=1);
    kind: string(min_length=1);
    state: "unknown_surface";
    surface: string(min_length=1);
  }
  error UnexpectedError;
  error ValidationError;
  capability "trellis.core::authority.read";
  rpc "Trellis.Surface.Status" {
    version "v1";
    input TrellisSurfaceStatusRequest;
    output TrellisSurfaceStatusResponse;
    errors [UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.core::authority.read"];
    }
  }
}

participant "trellis.auth-runtime" service {
  implements "trellis.auth@v1";
  type PermissionAction = "call" | "invoke" | "observe" | "cancel" | "control" | "publish" | "subscribe" | "read" | "write" | "delete" | "submit" | "process" | "consume";
  model ApiSurfaceTarget { kind: "apiSurface"; api: string; surface: "rpc" | "operation" | "event" | "feed" | "state"; name: string; }
  model ParticipantResourceTarget { kind: "participantResource"; participant: string; resource: "kv" | "store" | "jobQueue" | "eventConsumer" | "state"; name: string; }
  model OperationSignalTarget { kind: "operationSignal"; api: string; operation: string; signal: string; }
  type PermissionTarget = ApiSurfaceTarget | ParticipantResourceTarget | OperationSignalTarget;
  model PermissionAtom { target: PermissionTarget; action: PermissionAction; }
  model GrantSet { format: "trellis.grant-set.v1"; permissions: list<PermissionAtom>; }
  model BrowserConsentProposal {
    participantId: string;
    participantArtifactDigest: string;
    participantNeedsDigest: string;
    consentView: json;
    consentViewDigest: string;
    proposalDigest: string;
    requiredGrantSet: GrantSet;
    optionalGrantBundles: map<GrantSet>;
    requiredCapabilities: list<string>;
    optionalCapabilityDefinitions: map<GrantSet>;
  }
  type AuthBrowserFlowKind = "user_auth" | "device_activation";
  type AuthBrowserFlowState = "choose_provider" | "authenticated" | "approval_required" | "approval_denied" | "approved" | "consumed" | "expired";
  model AuthBrowserFlow {
    format: string;
    flowId: string;
    kind: AuthBrowserFlowKind;
    state: AuthBrowserFlowState;
    requestId: string;
    requestDigest: string;
    participantId: string;
    participantArtifactDigest: string;
    participantNeedsDigest: string;
    consent: BrowserConsentProposal;
    sessionPublicKey: string;
    sessionNkey: string;
    portalId: string;
    redirectTarget?: string | null;
    principalId?: string | null;
    authenticatedProviderId?: string | null;
    authenticatedRoles: list<string>;
    portalBindingDigest?: string | null;
    claimOwner?: string | null;
    claimedAt?: int | null;
    durableResultDigest?: string | null;
    completedAt?: int | null;
    createdAt: int;
    expiresAt: int;
    version: uint;
  }
  type AuthOAuthKind = "browser" | "account_flow";
  type AuthOAuthStatus = "pending" | "claimed" | "exchange_started" | "completed" | "restart_required" | "expired";
  model AuthOAuthState {
    format: string;
    stateId: string;
    providerId: string;
    kind: AuthOAuthKind;
    flowId: string;
    status: AuthOAuthStatus;
    pkceVerifier: string;
    nonce: string;
    redirectUri: string;
    browserBindingDigest: string;
    portalBindingDigest?: string | null;
    browserFlowId?: string | null;
    portalId?: string | null;
    portalPolicyDigest?: string | null;
    claimOwner?: string | null;
    resultDigest?: string | null;
    authenticatedPrincipalId?: string | null;
    authenticatedProviderSubject?: string | null;
    authenticatedEmail?: string | null;
    authenticatedRoles: list<string>;
    createdAt: int;
    expiresAt: int;
    version: uint;
  }
  model AuthConnectionPresence {
    format: string;
    connectionId: string;
    sessionId: string;
    contextDigest: string;
    serverId: string;
    clientId: string;
    userNkey: string;
    remoteAddress?: string | null;
    connectedAt: int;
    lastSeenAt: int;
    version: uint;
  }
  kv browserFlows {
    purpose "Store short-lived browser authentication and activation flow state.";
    schema AuthBrowserFlow;
    history 1;
    ttl_ms 86400000;
    max_value_bytes 65536;
  }
  kv oauthStates {
    purpose "Store CAS-consumed OAuth state, PKCE, and unknown-outcome recovery records.";
    schema AuthOAuthState;
    history 1;
    ttl_ms 900000;
    max_value_bytes 16384;
  }
  kv connections {
    purpose "Track current operational NATS connection presence.";
    schema AuthConnectionPresence;
    history 1;
    ttl_ms 120000;
    max_value_bytes 16384;
  }
}
