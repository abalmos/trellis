api "trellis.health@v1" {
  version "1.0.0";
  display_name "Trellis Health";
  description "Trellis-managed participant health projection and operational history.";
  model HealthHeartbeatSample {
    checks: list<HealthHeartbeatSamplechecksItem>(max_items=64);
    participant: HealthHeartbeatSampleparticipant;
    reportedStatus: "healthy" | "degraded" | "unhealthy";
    sample: HealthHeartbeatSamplesample;
    summary?: string(max_length=1024);
  }
  model HealthInspectRequest {
    contractId: string(min_length=1, max_length=256);
    historyLimit?: int(minimum=1, maximum=500);
    historySince?: string(format="date-time");
    instanceId?: string(min_length=1, max_length=128);
    participantKind: "service" | "device";
  }
  model HealthInspectResponse {
    asOf: string(format="date-time");
    history: list<HealthInspectResponsehistoryItem>;
    instances: list<HealthInspectResponseinstancesItem>;
    participant: HealthInspectResponseparticipant;
    projection: HealthInspectResponseprojection;
  }
  model HealthMetricsRequest {
    checkNames?: list<string(min_length=1, max_length=128)>(max_items=64);
    contractId: string(min_length=1, max_length=256);
    end: string(format="date-time");
    instanceIds?: list<string(min_length=1, max_length=128)>(max_items=100);
    participantKind: "service" | "device";
    start: string(format="date-time");
    stepMs: int(minimum=300000);
  }
  model HealthMetricsResponse {
    asOf: string(format="date-time");
    projection: HealthMetricsResponseprojection;
    series: list<HealthMetricsResponseseriesItem>;
    summary: HealthMetricsResponsesummary;
  }
  model HealthProjectionDiagnostics {
    completeSince?: string(format="date-time");
    gapDetected: bool;
    lastStreamSequence: uint;
    retainedFrom?: string(format="date-time");
    revision: uint;
  }
  model HealthQueryRequest {
    contractIds?: list<string(min_length=1, max_length=256)>(max_items=100);
    deploymentIds?: list<string(min_length=1, max_length=128)>(max_items=100);
    limit?: int(minimum=1, maximum=200);
    offset?: uint;
    participantKinds?: list<"service" | "device">(max_items=2);
    search?: string(max_length=256);
    statuses?: list<"healthy" | "degraded" | "unhealthy" | "offline">(max_items=4);
  }
  model HealthQueryResponse {
    asOf: string(format="date-time");
    count: uint;
    entries: list<HealthQueryResponseentriesItem>;
    limit: int(minimum=1);
    offset: uint;
    projection: HealthQueryResponseprojection;
  }
  model HealthStatusChangedEvent {
    changedAt: string(format="date-time");
    header: HealthStatusChangedEventheader;
    lastSeenAt: string(format="date-time");
    participant: HealthStatusChangedEventparticipant;
    previousStatus: "healthy" | "degraded" | "unhealthy" | "offline";
    reason: "heartbeat-change" | "heartbeat-resumed" | "deadline-expired";
    reportedStatus: "healthy" | "degraded" | "unhealthy";
    status: "healthy" | "degraded" | "unhealthy" | "offline";
    summary?: string(max_length=1024);
  }
  type HealthWatchFrame = HealthWatchFrameValue1 | HealthWatchFrameValue2;
  model HealthWatchRequest {
    contractIds?: list<string(min_length=1, max_length=256)>(max_items=100);
    deploymentIds?: list<string(min_length=1, max_length=128)>(max_items=100);
    instanceIds?: list<string(min_length=1, max_length=128)>(max_items=100);
    participantKinds?: list<"service" | "device">(max_items=2);
  }
  model NotFoundErrorData {
    context?: NotFoundErrorDatacontext;
    id: string(min_length=1);
    message: string;
    resource: string(min_length=1);
    traceId?: string;
    type: "NotFoundError";
  }
  model HealthHeartbeatSamplechecksItem {
    error?: string(max_length=1024);
    info?: HealthHeartbeatSamplechecksIteminfo;
    latencyMs: number(minimum=0, maximum=3600000);
    name: string(min_length=1, max_length=128);
    status: "ok" | "failed";
    summary?: string(max_length=1024);
  }
  model HealthHeartbeatSampleparticipant {
    contractDigest: string(min_length=1, max_length=256);
    contractId: string(min_length=1, max_length=256);
    info?: HealthHeartbeatSampleparticipantinfo;
    instanceId: string(min_length=1, max_length=128);
    kind: "service" | "device";
    name: string(min_length=1, max_length=256);
    publishIntervalMs: int(minimum=1000, maximum=600000);
    runtime: "deno" | "node" | "rust" | "unknown";
    runtimeVersion?: string(max_length=256);
    startedAt: string(format="date-time");
    version?: string(max_length=256);
  }
  model HealthHeartbeatSamplesample {
    id: string(pattern="^[0-9A-HJKMNP-TV-Z]{26}$");
    time: string(format="date-time");
  }
  model HealthInspectResponsehistoryItem {
    checks: list<HealthInspectResponsehistoryItemchecksItem>;
    effectiveStatus: "healthy" | "degraded" | "unhealthy" | "offline";
    endedAt?: string(format="date-time");
    instanceId: string;
    intervalId: int(minimum=1);
    reason: "first-sample" | "heartbeat-change" | "heartbeat-resumed" | "deadline-expired";
    reportedStatus: "healthy" | "degraded" | "unhealthy";
    startedAt: string(format="date-time");
  }
  model HealthInspectResponseinstancesItem {
    ageMs: uint;
    contractDigest: string;
    deploymentId: string;
    effectiveStatus: "healthy" | "degraded" | "unhealthy" | "offline";
    heartbeatDeadline: string(format="date-time");
    instanceId: string;
    latestSample: HealthInspectResponseinstancesItemlatestSample;
    observedAt: string(format="date-time");
    reportedStatus: "healthy" | "degraded" | "unhealthy";
    startedAt: string(format="date-time");
  }
  model HealthInspectResponseparticipant {
    contractId: string;
    effectiveStatus: "healthy" | "degraded" | "unhealthy" | "offline";
    offlineInstances: uint;
    onlineInstances: uint;
    participantKind: "service" | "device";
    participantName: string;
  }
  model HealthInspectResponseprojection {
    completeSince?: string(format="date-time");
    gapDetected: bool;
    lastStreamSequence: uint;
    retainedFrom?: string(format="date-time");
    revision: uint;
  }
  model HealthMetricsResponseprojection {
    completeSince?: string(format="date-time");
    gapDetected: bool;
    lastStreamSequence: uint;
    retainedFrom?: string(format="date-time");
    revision: uint;
  }
  model HealthMetricsResponseseriesItem {
    buckets: list<HealthMetricsResponseseriesItembucketsItem>;
    contractId: string;
    instanceId: string;
    participantKind: "service" | "device";
  }
  model HealthMetricsResponsesummary {
    availability?: number(minimum=0, maximum=1);
    observedMs: uint;
    onlineMs: uint;
    sampleCount: uint;
    transitions: uint;
  }
  model HealthQueryResponseentriesItem {
    contractDigests: list<string(min_length=1, max_length=128)>;
    contractId: string;
    deploymentIds: list<string(min_length=1, max_length=128)>;
    effectiveStatus: "healthy" | "degraded" | "unhealthy" | "offline";
    lastSeenAt: string(format="date-time");
    offlineInstances: uint;
    onlineInstances: uint;
    participantKind: "service" | "device";
    participantName: string;
    runtimes: list<string>;
    versions: list<string>;
  }
  model HealthQueryResponseprojection {
    completeSince?: string(format="date-time");
    gapDetected: bool;
    lastStreamSequence: uint;
    retainedFrom?: string(format="date-time");
    revision: uint;
  }
  model HealthStatusChangedEventheader {
    id: string(min_length=1, max_length=128);
    time: string(format="date-time");
  }
  model HealthStatusChangedEventparticipant {
    contractId: string;
    deploymentId: string;
    instanceId: string;
    kind: "service" | "device";
    name: string;
  }
  model HealthWatchFrameValue1 {
    projectionRevision: uint;
    type: "ready";
  }
  model HealthWatchFrameValue2 {
    changes?: list<HealthWatchFrameValue2changesItem>(max_items=100);
    projectionRevision: uint;
    type: "healthInvalidated";
  }
  model NotFoundErrorDatacontext {
  }
  model HealthHeartbeatSamplechecksIteminfo {
  }
  model HealthHeartbeatSampleparticipantinfo {
  }
  model HealthInspectResponsehistoryItemchecksItem {
    name: string;
    status: "ok" | "failed";
  }
  model HealthInspectResponseinstancesItemlatestSample {
    checks: list<HealthInspectResponseinstancesItemlatestSamplechecksItem>(max_items=64);
    participant: HealthInspectResponseinstancesItemlatestSampleparticipant;
    reportedStatus: "healthy" | "degraded" | "unhealthy";
    sample: HealthInspectResponseinstancesItemlatestSamplesample;
    summary?: string(max_length=1024);
  }
  model HealthMetricsResponseseriesItembucketsItem {
    checks: list<HealthMetricsResponseseriesItembucketsItemchecksItem>;
    degradedMs: uint;
    end: string(format="date-time");
    healthyMs: uint;
    observedMs: uint;
    offlineMs: uint;
    sampleCount: uint;
    start: string(format="date-time");
    unhealthyMs: uint;
  }
  model HealthWatchFrameValue2changesItem {
    contractId: string;
    deploymentId: string;
    instanceId: string;
    participantKind: "service" | "device";
  }
  model HealthInspectResponseinstancesItemlatestSamplechecksItem {
    error?: string(max_length=1024);
    info?: HealthInspectResponseinstancesItemlatestSamplechecksIteminfo;
    latencyMs: number(minimum=0, maximum=3600000);
    name: string(min_length=1, max_length=128);
    status: "ok" | "failed";
    summary?: string(max_length=1024);
  }
  model HealthInspectResponseinstancesItemlatestSampleparticipant {
    contractDigest: string(min_length=1, max_length=256);
    contractId: string(min_length=1, max_length=256);
    info?: HealthInspectResponseinstancesItemlatestSampleparticipantinfo;
    instanceId: string(min_length=1, max_length=128);
    kind: "service" | "device";
    name: string(min_length=1, max_length=256);
    publishIntervalMs: int(minimum=1000, maximum=600000);
    runtime: "deno" | "node" | "rust" | "unknown";
    runtimeVersion?: string(max_length=256);
    startedAt: string(format="date-time");
    version?: string(max_length=256);
  }
  model HealthInspectResponseinstancesItemlatestSamplesample {
    id: string(pattern="^[0-9A-HJKMNP-TV-Z]{26}$");
    time: string(format="date-time");
  }
  model HealthMetricsResponseseriesItembucketsItemchecksItem {
    failedCount: uint;
    latencyAverageMs: number(minimum=0);
    latencyMaxMs: number(minimum=0);
    name: string;
    okCount: uint;
    sampleCount: uint;
  }
  model HealthInspectResponseinstancesItemlatestSamplechecksIteminfo {
  }
  model HealthInspectResponseinstancesItemlatestSampleparticipantinfo {
  }
  export HealthHeartbeatSample;
  error NotFoundError {
    schema NotFoundErrorData;
  }
  error UnexpectedError;
  error ValidationError;
  capability "trellis.health::read" {
  }
  rpc "Health.Inspect" {
    version "v1";
    input HealthInspectRequest;
    output HealthInspectResponse;
    errors [NotFoundError, UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.health::read"];
    }
  }
  rpc "Health.Metrics" {
    version "v1";
    input HealthMetricsRequest;
    output HealthMetricsResponse;
    errors [UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.health::read"];
    }
  }
  rpc "Health.Query" {
    version "v1";
    input HealthQueryRequest;
    output HealthQueryResponse;
    errors [UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.health::read"];
    }
  }
  event "Health.StatusChanged" {
    version "v1";
    event HealthStatusChangedEvent;
    capabilities {
      subscribe ["trellis.health::read"];
    }
  }
  feed "Health.Watch" {
    version "v1";
    input HealthWatchRequest;
    event HealthWatchFrame;
    capabilities {
      subscribe ["trellis.health::read"];
    }
  }
}
api "trellis.state@v1" {
  version "1.0.0";
  display_name "Trellis State";
  description "Trellis-managed app state for authenticated app and device participants.";
  type JsonValue = json;
  type StateAdminDeleteRequest = StateAdminDeleteRequestValue1 | StateAdminDeleteRequestValue2;
  model StateAdminDeleteResponse {
    deleted: bool;
  }
  type StateAdminGetRequest = StateAdminGetRequestValue1 | StateAdminGetRequestValue2;
  type StateAdminGetResponse = StateAdminGetResponseValue1 | StateAdminGetResponseValue2 | StateAdminGetResponseValue3;
  type StateAdminListRequest = StateAdminListRequestValue1 | StateAdminListRequestValue2;
  model StateAdminListResponse {
    count: uint;
    entries: list<StateAdminListResponseentriesItem1 | StateAdminListResponseentriesItem2>;
    limit: uint;
    nextOffset?: uint;
    offset: uint;
  }
  model StateDeleteRequest {
    expectedRevision?: string(min_length=1);
    key?: string(min_length=1);
    store: string(min_length=1);
  }
  model StateDeleteResponse {
    deleted: bool;
  }
  model StateEntry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StateGetRequest {
    key?: string(min_length=1);
    store: string(min_length=1);
  }
  type StateGetResponse = StateGetResponseValue1 | StateGetResponseValue2 | StateGetResponseValue3;
  model StateListRequest {
    limit: uint;
    offset?: uint;
    prefix?: string(min_length=1);
    store: string(min_length=1);
  }
  model StateListResponse {
    count: uint;
    entries: list<StateListResponseentriesItem1 | StateListResponseentriesItem2>;
    limit: uint;
    nextOffset?: uint;
    offset: uint;
  }
  model StateMigrationRequired {
    currentStateVersion: string(min_length=1);
    entry: StateMigrationRequiredentry;
    migrationRequired: true;
    stateVersion: string(min_length=1);
    writerContractDigest: string(min_length=1);
  }
  model StatePutRequest {
    expectedRevision?: string(min_length=1) | null;
    key?: string(min_length=1);
    store: string(min_length=1);
    ttlMs?: int(minimum=1);
    value: json;
  }
  type StatePutResponse = StatePutResponseValue1 | StatePutResponseValue2;
  model StateAdminDeleteRequestValue1 {
    contractDigest: string(min_length=1);
    contractId: string(min_length=1);
    expectedRevision?: string(min_length=1);
    key?: string(min_length=1);
    scope: "userApp";
    store: string(min_length=1);
    userId: string(min_length=1);
  }
  model StateAdminDeleteRequestValue2 {
    contractDigest: string(min_length=1);
    contractId: string(min_length=1);
    deviceId: string(min_length=1);
    expectedRevision?: string(min_length=1);
    key?: string(min_length=1);
    scope: "deviceApp";
    store: string(min_length=1);
  }
  model StateAdminGetRequestValue1 {
    contractDigest: string(min_length=1);
    contractId: string(min_length=1);
    key?: string(min_length=1);
    scope: "userApp";
    store: string(min_length=1);
    userId: string(min_length=1);
  }
  model StateAdminGetRequestValue2 {
    contractDigest: string(min_length=1);
    contractId: string(min_length=1);
    deviceId: string(min_length=1);
    key?: string(min_length=1);
    scope: "deviceApp";
    store: string(min_length=1);
  }
  model StateAdminGetResponseValue1 {
    found: false;
  }
  model StateAdminGetResponseValue2 {
    entry: StateAdminGetResponseValue2entry;
    found: true;
  }
  model StateAdminGetResponseValue3 {
    currentStateVersion: string(min_length=1);
    entry: StateAdminGetResponseValue3entry;
    migrationRequired: true;
    stateVersion: string(min_length=1);
    writerContractDigest: string(min_length=1);
  }
  model StateAdminListRequestValue1 {
    contractDigest: string(min_length=1);
    contractId: string(min_length=1);
    limit: uint;
    offset?: uint;
    prefix?: string(min_length=1);
    scope: "userApp";
    store: string(min_length=1);
    userId: string(min_length=1);
  }
  model StateAdminListRequestValue2 {
    contractDigest: string(min_length=1);
    contractId: string(min_length=1);
    deviceId: string(min_length=1);
    limit: uint;
    offset?: uint;
    prefix?: string(min_length=1);
    scope: "deviceApp";
    store: string(min_length=1);
  }
  model StateAdminListResponseentriesItem1 {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StateAdminListResponseentriesItem2 {
    currentStateVersion: string(min_length=1);
    entry: StateAdminListResponseentriesItem2entry;
    migrationRequired: true;
    stateVersion: string(min_length=1);
    writerContractDigest: string(min_length=1);
  }
  model StateGetResponseValue1 {
    found: false;
  }
  model StateGetResponseValue2 {
    entry: StateGetResponseValue2entry;
    found: true;
  }
  model StateGetResponseValue3 {
    currentStateVersion: string(min_length=1);
    entry: StateGetResponseValue3entry;
    migrationRequired: true;
    stateVersion: string(min_length=1);
    writerContractDigest: string(min_length=1);
  }
  model StateListResponseentriesItem1 {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StateListResponseentriesItem2 {
    currentStateVersion: string(min_length=1);
    entry: StateListResponseentriesItem2entry;
    migrationRequired: true;
    stateVersion: string(min_length=1);
    writerContractDigest: string(min_length=1);
  }
  model StateMigrationRequiredentry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StatePutResponseValue1 {
    applied: true;
    entry: StatePutResponseValue1entry;
  }
  model StatePutResponseValue2 {
    applied: false;
    entry?: StatePutResponseValue2entry1 | StatePutResponseValue2entry2;
    found: bool;
  }
  model StateAdminGetResponseValue2entry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StateAdminGetResponseValue3entry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StateAdminListResponseentriesItem2entry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StateGetResponseValue2entry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StateGetResponseValue3entry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StateListResponseentriesItem2entry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StatePutResponseValue1entry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StatePutResponseValue2entry1 {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  model StatePutResponseValue2entry2 {
    currentStateVersion: string(min_length=1);
    entry: StatePutResponseValue2entry2entry;
    migrationRequired: true;
    stateVersion: string(min_length=1);
    writerContractDigest: string(min_length=1);
  }
  model StatePutResponseValue2entry2entry {
    expiresAt?: string(format="date-time");
    key?: string(min_length=1);
    revision: string(min_length=1);
    updatedAt: string(format="date-time");
    value: json;
  }
  error AuthError;
  error UnexpectedError;
  error ValidationError;
  capability "trellis.state::mutate" {
  }
  capability "trellis.state::read" {
  }
  rpc "State.Admin.Delete" {
    version "v1";
    input StateAdminDeleteRequest;
    output StateAdminDeleteResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.state::mutate"];
    }
  }
  rpc "State.Admin.Get" {
    version "v1";
    input StateAdminGetRequest;
    output StateAdminGetResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.state::read"];
    }
  }
  rpc "State.Admin.List" {
    version "v1";
    input StateAdminListRequest;
    output StateAdminListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
    capabilities {
      call ["trellis.state::read"];
    }
  }
  rpc "State.Delete" {
    version "v1";
    input StateDeleteRequest;
    output StateDeleteResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc "State.Get" {
    version "v1";
    input StateGetRequest;
    output StateGetResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc "State.List" {
    version "v1";
    input StateListRequest;
    output StateListResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
  rpc "State.Put" {
    version "v1";
    input StatePutRequest;
    output StatePutResponse;
    errors [AuthError, UnexpectedError, ValidationError];
  }
}

api "trellis.auth@v1" {
  version "1.0.0";
  display_name "Trellis Auth";
  description "Authenticate Trellis principals and administer sessions, deployments, exact authority, devices, and login portals.";
  model AuthCapabilitiesListRequest {
    cursor?: string(min_length=1);
    limit?: int(minimum=1, maximum=100);
    sourceApi?: string(min_length=1);
  }
  model AuthCapabilitiesListResponse {
    entries: list<AuthCapabilitiesListResponseentriesItem>;
    nextCursor: string | null;
  }
  model AuthCapabilityGroupsDeleteRequest {
    expectedVersion: uint;
    groupKey: string(min_length=1);
    idempotencyKey: string(min_length=1);
  }
  model AuthCapabilityGroupsDeleteResponse {
    success: bool;
  }
  model AuthCapabilityGroupsGetRequest {
    groupKey: string(min_length=1);
  }
  model AuthCapabilityGroupsGetResponse {
    group: AuthCapabilityGroupsGetResponsegroup;
  }
  model AuthCapabilityGroupsListRequest {
    limit: uint(maximum=500);
    offset?: uint;
  }
  model AuthCapabilityGroupsListResponse {
    count: uint;
    entries: list<AuthCapabilityGroupsListResponseentriesItem>;
    limit: uint;
    nextOffset?: uint;
    offset: uint;
  }
  model AuthCapabilityGroupsPutRequest {
    capabilities: list<string(min_length=1)>;
    description: string(min_length=1);
    displayName: string(min_length=1);
    expectedVersion: uint | null;
    groupKey: string(min_length=1);
    idempotencyKey: string(min_length=1);
    includedGroups: list<string(min_length=1)>;
  }
  model AuthCapabilityGroupsPutResponse {
    group: AuthCapabilityGroupsPutResponsegroup;
  }
  model AuthConnectionsClosedEvent {
    connectionId: string(min_length=1);
    eventId: string(min_length=1);
    occurredAt: uint(maximum=9007199254740991);
    participantId: string(min_length=1);
    principalId: string(min_length=1);
    reason: string | null;
    sessionId: string(min_length=1);
  }
  model AuthConnectionsKickRequest {
    connectionId: string(min_length=1);
    idempotencyKey: string(min_length=1);
    reason: string | null;
  }
  model AuthConnectionsKickResponse {
    connectionId: string(min_length=1);
    kicked: bool;
  }
  model AuthConnectionsKickedEvent {
    connectionId: string(min_length=1);
