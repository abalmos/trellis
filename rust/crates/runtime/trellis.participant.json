{
  "format": "trellis.participant.v1",
  "id": "trellis-auth-runtime",
  "displayName": "Trellis Auth Runtime",
  "description": "Rust-owned platform participant that implements authentication, bootstrap, and auth callout.",
  "kind": "service",
  "schemas": {
    "AuthBrowserFlow": {
      "type": "object",
      "properties": {
        "format": {
          "const": "trellis.auth-browser-flow.v1"
        },
        "flowId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "user_auth",
            "device_activation"
          ]
        },
        "state": {
          "enum": [
            "choose_provider",
            "authenticated",
            "approval_required",
            "approval_denied",
            "approved",
            "consumed",
            "expired"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "participantId": {
          "type": "string",
          "minLength": 1
        },
        "participantArtifactDigest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "participantNeedsDigest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "sessionPublicKey": {
          "type": "string",
          "minLength": 1
        },
        "sessionNkey": {
          "type": "string",
          "minLength": 1
        },
        "portalId": {
          "type": "string",
          "minLength": 1
        },
        "redirectTarget": {
          "type": [
            "string",
            "null"
          ]
        },
        "principalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimOwner": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durableResultDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "completedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "format",
        "flowId",
        "kind",
        "state",
        "requestId",
        "requestDigest",
        "participantId",
        "participantArtifactDigest",
        "participantNeedsDigest",
        "sessionPublicKey",
        "sessionNkey",
        "portalId",
        "redirectTarget",
        "principalId",
        "claimOwner",
        "claimedAt",
        "durableResultDigest",
        "completedAt",
        "createdAt",
        "expiresAt",
        "version"
      ]
    },
    "AuthOAuthState": {
      "type": "object",
      "properties": {
        "format": {
          "const": "trellis.auth-oauth-state.v1"
        },
        "stateId": {
          "type": "string",
          "minLength": 1
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "browser",
            "account_flow"
          ]
        },
        "flowId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "claimed",
            "exchange_started",
            "completed",
            "restart_required",
            "expired"
          ]
        },
        "pkceVerifier": {
          "type": "string",
          "minLength": 1
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        },
        "redirectUri": {
          "type": "string",
          "minLength": 1
        },
        "claimOwner": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "format",
        "stateId",
        "providerId",
        "kind",
        "flowId",
        "status",
        "pkceVerifier",
        "nonce",
        "redirectUri",
        "claimOwner",
        "resultDigest",
        "createdAt",
        "expiresAt",
        "version"
      ]
    },
    "AuthConnectionPresence": {
      "type": "object",
      "properties": {
        "format": {
          "const": "trellis.auth-connection-presence.v1"
        },
        "connectionId": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "serverId": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "userNkey": {
          "type": "string",
          "minLength": 1
        },
        "remoteAddress": {
          "type": [
            "string",
            "null"
          ]
        },
        "connectedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastSeenAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "format",
        "connectionId",
        "sessionId",
        "serverId",
        "clientId",
        "userNkey",
        "remoteAddress",
        "connectedAt",
        "lastSeenAt",
        "version"
      ]
    }
  },
  "implements": {
    "auth": {
      "api": "trellis.auth@v1",
      "apiDigest": "Fs_nA37wXgMpLRfB7IyYDhIEDUdSl3PdNp6ehnXcV1A"
    }
  },
  "uses": {
    "required": {},
    "optional": {}
  },
  "state": {},
  "jobQueues": {},
  "eventConsumers": {},
  "resources": {
    "kv": {
      "browserFlows": {
        "purpose": "Store short-lived browser authentication and activation flow state.",
        "schema": {
          "schema": "AuthBrowserFlow"
        },
        "history": 1,
        "ttlMs": 86400000,
        "maxValueBytes": 65536
      },
      "oauthStates": {
        "purpose": "Store CAS-consumed OAuth state, PKCE, and unknown-outcome recovery records.",
        "schema": {
          "schema": "AuthOAuthState"
        },
        "history": 1,
        "ttlMs": 900000,
        "maxValueBytes": 16384
      },
      "connections": {
        "purpose": "Track current operational NATS connection presence.",
        "schema": {
          "schema": "AuthConnectionPresence"
        },
        "history": 1,
        "ttlMs": 120000,
        "maxValueBytes": 16384
      }
    }
  }
}
