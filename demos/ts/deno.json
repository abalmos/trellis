{
  "workspace": ["./service", "./device"],
  "tasks": {
    "check": "deno task check:service && deno task check:device",
    "check:service": "deno task -c service/deno.json check",
    "check:device": "deno task -c device/deno.json check",
    "service": "deno task -c service/deno.json start",
    "device": "deno task -c device/deno.json start"
  },
  "imports": {
    "@qlever-llc/result": "../../ts/packages/result/mod.ts",
    "@qlever-llc/trellis": "../../ts/packages/trellis/index.ts",
    "@qlever-llc/trellis/device/deno": "../../ts/packages/trellis/device/deno.ts",
    "@qlever-llc/trellis/errors": "../../ts/packages/trellis/errors/index.ts",
    "@qlever-llc/trellis/service": "../../ts/packages/trellis/service/mod.ts",
    "@qlever-llc/trellis/service/deno": "../../ts/packages/trellis/service/deno.ts",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.1",
    "@libs/qrcode": "jsr:@libs/qrcode@^3.0.1",
    "chalk": "npm:chalk@^5.6.2",
    "typebox": "npm:typebox@^1.0.15",
    "ulid": "npm:ulid@^3.0.1"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "verbatimModuleSyntax": true
  }
}
