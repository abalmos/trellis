{
  "extends": "../deno.json",
  "name": "@trellis-demo/service",
  "version": "0.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "update": "../../../rust/target/debug/trellis update",
    "generate": "../../../rust/target/debug/trellis generate",
    "check": "deno check src/main.ts",
    "start": "deno run --allow-env --allow-net --allow-sys --allow-write=/tmp src/main.ts"
  }
}
